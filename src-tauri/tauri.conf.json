{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audio Atlas",
  "version": "0.1.0",
  "identifier": "studio.audioatlas.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Audio Atlas",
      "width": 1380,
      "height": 900,
      "minWidth": 840,
      "minHeight": 620,
      "backgroundColor": "#141615"
    }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "macOS": { "minimumSystemVersion": "13.0" },
    "icon": ["icons/icon.png", "icons/icon.icns"]
  }
}
